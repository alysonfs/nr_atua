# ==============================================================================
# ATUA MVP - Environment Variables Template
# ==============================================================================
# IMPORTANTE: Nunca comitar este arquivo com valores reais.
# Use `.env.local` para desenvolvimento local.
# Use `.env.{environment}` para staging/production (via secrets manager ou CI/CD).
# ==============================================================================

# ====== AWS REGION & ACCOUNT ======
AWS_REGION=sa-east-1
AWS_ACCOUNT_ID=<your-account-id>

# ====== KMS ENCRYPTION ======
# ARN da Customer Master Key para criptografia de dados sensíveis
KMS_KEY_ID=arn:aws:kms:sa-east-1:<ACCOUNT_ID>:key/<KEY_UUID>
KMS_KEY_ALIAS=alias/atua-mvp-key

# ====== SECRETS MANAGER ======
# IDs dos segredos no AWS Secrets Manager
SECRETS_MANAGER_SECRET_ROOT=atua/root
SECRETS_MANAGER_SECRET_RDS=atua/rds-postgres
SECRETS_MANAGER_SECRET_DOCUMENTDB=atua/documentdb

# ====== PostgreSQL (RDS) ======
# Endpoint: RDS fornecerá isso após provisionamento
DB_HOST=atua-postgres.xxxxx.sa-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=atua_prod
DB_USER=atua_app
# DB_PASSWORD: NUNCA definir aqui! Carregar do Secrets Manager em runtime
# Exemplo de connection string (para drivers que suportam):
# postgresql://atua_app@<DB_HOST>:5432/atua_prod?sslmode=require

# Conexão via Secrets Manager:
# 1. aws secretsmanager get-secret-value --secret-id atua/rds-postgres
# 2. Extrair username, password, host, port do JSON retornado
# 3. Construir connection string em tempo de inicialização da aplicação

# Pool de conexões
DB_CONNECTION_POOL_SIZE=20
DB_CONNECTION_TIMEOUT_SECONDS=30
DB_QUERY_TIMEOUT_SECONDS=30

# Retenção de backups (dias)
DB_BACKUP_RETENTION_DAYS=35

# ====== DocumentDB (MongoDB) ======
# Endpoint: DocumentDB fornecerá isso após provisionamento
MONGODB_HOST=atua-cluster.xxxxx.sa-east-1.docdb.amazonaws.com
MONGODB_PORT=27017
MONGODB_NAME=atua_prod
MONGODB_USER=atua_app
# MONGODB_PASSWORD: NUNCA definir aqui! Carregar do Secrets Manager em runtime

# Connection string completa (template):
# mongodb+srv://atua_app:<PASSWORD>@<MONGODB_HOST>/atua_prod?ssl=true&retryWrites=true
MONGODB_URI=mongodb+srv://atua_app@atua-cluster.xxxxx.sa-east-1.docdb.amazonaws.com/atua_prod?ssl=true

# Pool de conexões
MONGODB_CONNECTION_POOL_SIZE=10
MONGODB_CONNECTION_TIMEOUT_SECONDS=30

# Retenção de backup (dias)
MONGODB_BACKUP_RETENTION_DAYS=35

# ====== AWS SES (Simple Email Service) ======
# Region: SES está disponível em us-east-1 (melhor para envios globais)
SES_REGION=us-east-1
# Email sender (domínio verificado no SES)
SES_SENDER_EMAIL=noreply@atua.example.com
SES_SENDER_NAME=ATUA

# Templates configurados no SES
SES_TEMPLATE_CONFIRMATION_EMAIL=confirmation-email
SES_TEMPLATE_TRIAL_EXPIRING=trial-expiring-soon

# Rate limits (SES permite 14 emails/segundo no modo production)
SES_RATE_LIMIT_PER_SECOND=14

# ====== IDENTIDADE & AUTENTICAÇÃO ======
# JWT
JWT_SECRET_KEY=<gerado-em-secrets-manager>
JWT_ISSUER=atua.example.com
JWT_AUDIENCE=atua-office,atua-manager
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Refresh Token (stored in PostgreSQL as hash)
REFRESH_TOKEN_ROTATION_POLICY=ROTATE_ON_USE
REFRESH_TOKEN_FAMILY_REVOCATION=true

# Bootstrap (APENAS no primeiro deploy!)
# Token único gerado em Secrets Manager
BOOTSTRAP_TOKEN=<uuid-gerado-secretamente>
BOOTSTRAP_ENABLED=false  # Desabilitar após primeiro uso!
BOOTSTRAP_ROOT_EMAIL=admin@example.com
BOOTSTRAP_ROOT_PASSWORD=<será-definida-pelo-admin-na-primeira-vez>

# ====== COLLECTOR WORKER ======
# Agente coletor (Playwright automation do iService)
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_SECONDS=900  # 15 minutos

# iService (target system)
ISERVICE_BASE_URL=https://api.iservice.provider.com
ISERVICE_CAS_URL=https://cas.iservice.provider.com/cas
ISERVICE_API_VERSION=v2

# Timeout para Playwright
COLLECTOR_PLAYWRIGHT_TIMEOUT_MS=30000
COLLECTOR_PLAYWRIGHT_HEADLESS=true
COLLECTOR_PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=60000

# Retry policy
COLLECTOR_MAX_RETRIES=3
COLLECTOR_RETRY_DELAY_MS=5000
COLLECTOR_EXPONENTIAL_BACKOFF=true

# ====== TRIAL & LICENSING ======
# Duração do trial
TRIAL_DURATION_DAYS=7
TRIAL_WARNING_DAYS=2
TRIAL_WARNING_HOURS=12

# Email de aviso
TRIAL_WARNING_EMAIL_TEMPLATE=trial-expiring-soon
TRIAL_WARNING_SEND_DAYS_BEFORE_EXPIRY=2

# ====== VPC & NETWORK ======
# VPC Endpoints (para segurança em VPC privada)
VPC_ID=vpc-xxxxxxxx
VPC_PRIVATE_SUBNET_1=subnet-xxxxxxxx  # sa-east-1a
VPC_PRIVATE_SUBNET_2=subnet-yyyyyyyy  # sa-east-1b
VPC_PUBLIC_SUBNET_1=subnet-zzzzzzzz   # sa-east-1a (NAT Gateway)
VPC_PUBLIC_SUBNET_2=subnet-wwwwwwww   # sa-east-1b (future HA)

# Security Groups
SG_MASTER_API=sg-xxxxxxxx
SG_COLLECTOR_WORKER=sg-yyyyyyyy
SG_RDS=sg-zzzzzzzz
SG_DOCUMENTDB=sg-wwwwwwww

# ====== LOGGING & OBSERVABILITY ======
# CloudWatch
CLOUDWATCH_LOG_GROUP=/atua/master-api
CLOUDWATCH_LOG_STREAM=prod-stream
CLOUDWATCH_LOG_RETENTION_DAYS=30

# Collector logs
CLOUDWATCH_COLLECTOR_LOG_GROUP=/atua/collector
CLOUDWATCH_COLLECTOR_LOG_STREAM=prod-stream

# Metrics namespace
METRICS_ENABLED=true
METRICS_NAMESPACE=ATUA/MVP
METRICS_FLUSH_INTERVAL_SECONDS=60

# Structured logging (recomendado para rastreamento)
LOGGING_LEVEL=Information
LOGGING_FORMAT=JSON  # vs. Text
LOGGING_REDACT_PII=true  # Mascarar email, tokens, etc.

# ====== AUDIT & COMPLIANCE ======
# Auditoria (PII/GDPR/LGPD)
AUDIT_ENABLED=true
AUDIT_LOG_TABLE=audit.log
AUDIT_RETENTION_DAYS=2555  # 7 anos

# PII fields (para redação em logs)
PII_FIELDS=email,password_hash,iservice_credentials,cas_session_cookie,jwt_token,refresh_token

# Data retention policy
DATA_RETENTION_YEARS=5
DATA_SOFT_DELETE_ENABLED=true
DATA_HARD_DELETE_ENABLED=true
DATA_HARD_DELETE_AFTER_DAYS=1825  # 5 anos

# ====== FEATURE FLAGS ======
# Funcionalidades futuras (desabilitadas no MVP)
FEATURE_LOGIN_FEDERATED=false
FEATURE_LOGIN_GOOGLE=false
FEATURE_LOGIN_META=false
FEATURE_MULTIPLE_OWNERS=false
FEATURE_RAG_ENABLED=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_WEBHOOK_EVENTS=false
FEATURE_CUSTOM_WORKFLOWS=false

# ====== DEPLOYMENT & ENVIRONMENT ======
ENVIRONMENT=development
ASPNETCORE_ENVIRONMENT=Development
IS_PRODUCTION=false

# ====== CORS & SECURITY ======
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://office.atua.example.com,https://manager.atua.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_CREDENTIALS=true

# ====== RATE LIMITING ======
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=600  # 10 req/sec
RATE_LIMIT_BURST_REQUESTS=50

# ====== HEALTH CHECK ======
HEALTHCHECK_ENABLED=true
HEALTHCHECK_INTERVAL_SECONDS=30
HEALTHCHECK_TIMEOUT_SECONDS=5

# ====== SECRETS ENCRYPTION ======
# Para criptografia de credenciais iService em repouso
ENCRYPTION_ALGORITHM=AES-256-GCM
ENCRYPTION_IV_SIZE_BYTES=12
ENCRYPTION_TAG_SIZE_BYTES=16
ENCRYPTION_KEY_DERIVATION=PBKDF2

# ====== DEBUGGING ======
# NUNCA habilitar em produção
DEBUG_MODE=false
DEBUG_SQL_QUERIES=false
DEBUG_EXTERNAL_API_CALLS=false
VERBOSE_LOGGING=false

# ====== OPTIONAL: Local Development ======
# Para Docker Compose ou banco local
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433  # Local container port
# MONGODB_HOST=localhost
# MONGODB_PORT=27018  # Local container port
# REDIS_HOST=localhost (futuro)
# REDIS_PORT=6379 (futuro)

# ==============================================================================
# NOTAS:
# ==============================================================================
#
# 1. NUNCA commitar este arquivo com valores sensíveis:
#    - KMS_KEY_ID
#    - DB_HOST, DB_USER
#    - MONGODB_HOST, MONGODB_USER
#    - JWT_SECRET_KEY
#    - BOOTSTRAP_TOKEN
#
# 2. Em PRODUCTION:
#    - Carregar valores via AWS Secrets Manager
#    - Usar IAM roles (não access keys)
#    - Habilitar CloudTrail para auditoria
#    - Habilitar VPC Flow Logs
#
# 3. Em DEVELOPMENT:
#    - Usar .env.local (não versionado)
#    - Pode usar valores dummy para testes locais
#    - Banco local via Docker Compose
#
# 4. Rotação de Segredos:
#    - KMS: Automática (anual)
#    - Secrets Manager: Automática (30 dias) ou manual
#    - JWT_SECRET_KEY: Manual (com zero-downtime rollover)
#    - Refresh tokens: Rotacionados por usuário
#
# 5. Documentação de Carregamento:
#    - Master API: Carregar em Program.cs via IConfiguration
#    - Collector: Idem, via Worker host builder
#    - Nunca em constructores de modelos (evitar bootstrap de segredos)
#
# ==============================================================================
