@Atua.Api_HostAddress = http://localhost:5240
@Atua.Api.ServiceCredentialToken = {{serviceCredentialToken}}
@tenantId = 00000000-0000-0000-0000-000000000000
@triagemId = 00000000-0000-0000-0000-000000000000

GET {{Atua.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

# Início idempotente da triagem (ADR-039; arquitetura, seção 3, itens 2/3).
# Autorizado via credencial de serviço com escopo exclusivo "triage.start".
# Tenant e integração vêm dos claims da credencial — não do corpo.
# Reentregas do mesmo WorkOrderProviderId retornam 200 com o estado atual;
# a primeira chamada retorna 201 com Location do recurso interno da triagem.
POST {{Atua.Api_HostAddress}}/api/internal/triagens/start
Content-Type: application/json
Authorization: Bearer {{Atua.Api.ServiceCredentialToken}}

{
  "workOrderProviderId": "OS-EXT-1"
}

###

# Evento inbound MessageReceived (ADR-043). Use somente com credencial
# channel.message.ingest e dados de teste; tenant/integração vêm do token.
POST {{Atua.Api_HostAddress}}/api/internal/triagens/canal/mensagens
Content-Type: application/json
Authorization: Bearer {{channelMessageIngestServiceToken}}

{
  "contractVersion": "1",
  "channelMessageId": "wamid-example",
  "channelIdempotencyKey": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "correlationId": "55555555-5555-4555-8555-555555555555",
  "senderPhone": "5511999991234",
  "conversationKind": "individual",
  "fromMe": false,
  "receivedAtUtc": "2026-10-17T12:00:00Z",
  "kind": "text",
  "text": "O produto não liga."
}

###

# Pool de triagem — C1: lista (épico "Pool de triagem — visão do
# operador"). Autenticado via sessão do Office (cookie "BrowserSession" —
# substitua pelo cookie real de uma sessão autenticada local). Isolamento
# por tenant obrigatório: usuário precisa ser membro de {{tenantId}}.
# Filtro opcional "status" aceita apenas um dos quatro estados do pool:
# LiberadaAoPool, Expirada, FalhaDeContato, AguardandoIntervencao.
GET {{Atua.Api_HostAddress}}/api/tenants/{{tenantId}}/triage-pool
Cookie: BrowserSession=******

###

# Pool de triagem — C1: lista filtrada por estado.
GET {{Atua.Api_HostAddress}}/api/tenants/{{tenantId}}/triage-pool?status=LiberadaAoPool
Cookie: BrowserSession=******

###

# Pool de triagem — C2: detalhe. Triagem assumida só é visível para quem
# assumiu ou para gestores (OWNER/ADMIN) — demais casos retornam 404.
# Outro tenant também retorna 404 (isolamento multi-tenant).
GET {{Atua.Api_HostAddress}}/api/tenants/{{tenantId}}/triage-pool/{{triagemId}}
Cookie: BrowserSession=******

###

# Pool de triagem — C3: assumir. Concorrência otimista: o perdedor de uma
# corrida recebe 409 com quem assumiu e quando.
POST {{Atua.Api_HostAddress}}/api/tenants/{{tenantId}}/triage-pool/{{triagemId}}/assume
Cookie: BrowserSession=******

###

# Pareamento via QR (ADR-049) — reporte do Channel. Autorizado via
# credencial de serviço com escopo exclusivo "channel.session.report";
# tenant/integração vêm dos claims do token, não do corpo. Guarda apenas o
# último estado — qualquer reporte substitui o anterior. 204 em sucesso.
POST {{Atua.Api_HostAddress}}/api/internal/channel/session
Content-Type: application/json
Authorization: ******

{
  "state": "qr_pending",
  "qr": "2@abc123,def456,...(texto bruto gerado pelo Baileys)",
  "atUtc": "2026-10-22T12:00:00Z"
}

###

# Pareamento via QR — reporte de conexão estabelecida (zera QR, guarda o
# telefone pareado).
POST {{Atua.Api_HostAddress}}/api/internal/channel/session
Content-Type: application/json
Authorization: ******

{
  "state": "connected",
  "phoneNumber": "5511999991234",
  "atUtc": "2026-10-22T12:00:05Z"
}

###

# Pareamento via QR — reporte de logout (sessão Baileys invalidada;
# tenant precisa ler um novo QR).
POST {{Atua.Api_HostAddress}}/api/internal/channel/session
Content-Type: application/json
Authorization: ******

{
  "state": "logged_out",
  "atUtc": "2026-10-22T12:10:00Z"
}

###

# Pareamento via QR — Office consulta o último estado conhecido. Restrito
# a membros OWNER/ADMIN do tenant (sessão de navegador). Sem estado
# reportado ainda, devolve state="unknown". O QR só volta no corpo
# enquanto state="qr_pending" e ainda não expirou (~60s do reporte).
GET {{Atua.Api_HostAddress}}/api/tenants/{{tenantId}}/whatsapp-session
Cookie: BrowserSession=******

###

# Pareamento via QR — variante com integrationId explícito, necessária
# quando o tenant tem mais de uma integração WhatsApp (sem isso, a API
# responde 400 integration_id_required).
GET {{Atua.Api_HostAddress}}/api/tenants/{{tenantId}}/whatsapp-session?integrationId=00000000-0000-0000-0000-000000000000
Cookie: BrowserSession=******

###
