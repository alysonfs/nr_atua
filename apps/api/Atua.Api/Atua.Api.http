@Atua.Api_HostAddress = http://localhost:5240
@Atua.Api.ServiceCredentialToken = {{serviceCredentialToken}}

GET {{Atua.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

# Início idempotente da triagem (ADR-039; arquitetura, seção 3, itens 2/3).
# Autorizado via credencial de serviço com escopo exclusivo "triage.start".
# Tenant e integração vêm dos claims da credencial — não do corpo.
# Reentregas do mesmo WorkOrderProviderId retornam 200 com o estado atual;
# a primeira chamada retorna 201 com Location do recurso interno da triagem.
POST {{Atua.Api_HostAddress}}/api/internal/triagens/start
Content-Type: application/json
Authorization: Bearer {{Atua.Api.ServiceCredentialToken}}

{
  "workOrderProviderId": "OS-EXT-1"
}

###

# Evento inbound MessageReceived (ADR-043). Use somente com credencial
# channel.message.ingest e dados de teste; tenant/integração vêm do token.
POST {{Atua.Api_HostAddress}}/api/internal/triagens/canal/mensagens
Content-Type: application/json
Authorization: Bearer {{channelMessageIngestServiceToken}}

{
  "contractVersion": "1",
  "channelMessageId": "wamid-example",
  "channelIdempotencyKey": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "correlationId": "55555555-5555-4555-8555-555555555555",
  "senderPhone": "5511999991234",
  "conversationKind": "individual",
  "fromMe": false,
  "receivedAtUtc": "2026-10-17T12:00:00Z",
  "kind": "text",
  "text": "O produto não liga."
}

###
